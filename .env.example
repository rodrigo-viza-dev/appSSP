# URL pública; nunca colocar claves ni contraseñas en EXPO_PUBLIC_.
# La leen npm start, web:configurado y export:web; npm run web fija la API local de pruebas.
EXPO_PUBLIC_API_URL=https://back-cs-de-la-com.vercel.app
# Identificador público OAuth de tipo Web; nunca el secreto.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
