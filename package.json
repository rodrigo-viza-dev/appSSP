{
  "name": "app-ssp",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 5173",
    "movil:pruebas": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/movil-pruebas.ps1",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/web-pruebas.ps1",
    "web:pruebas": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/web-pruebas.ps1",
    "web:configurado": "expo start --web --port 5173 --localhost",
    "typecheck": "tsc --noEmit",
    "test:api": "node --test tests/api.test.cjs tests/aulas.test.cjs tests/centro.test.cjs tests/notificaciones.test.cjs",
    "test:login:real": "node tests/browser-login-real.cjs",
    "test:base:real": "node tests/browser-base-funcional.cjs",
    "test:google:real": "node tests/browser-google-ready.cjs",
    "test:navigation": "node tests/browser-navigation.cjs",
    "test:alumno": "node tests/browser-alumno.cjs",
    "test:aulas": "node tests/browser-aulas.cjs",
    "test:practica": "node tests/browser-practica.cjs",
    "test:comunicacion": "node tests/browser-comunicacion.cjs",
    "test:communication:unit": "node --test tests/communication-drafts.test.cjs",
    "test:role-navigation:unit": "node --test tests/navigation-map.test.cjs",
    "test:roles": "node tests/browser-roles.cjs",
    "test:personal": "node tests/browser-personal.cjs",
    "test:centro": "node tests/browser-centro.cjs",
    "test:avisos": "node tests/browser-avisos.cjs",
    "test:docencia": "node tests/browser-docencia.cjs",
    "test:asistencia": "node tests/browser-asistencia.cjs",
    "export:web": "expo export --platform web",
    "test:horas": "node tests/browser-horas.cjs",
    "test:tareas": "node tests/browser-tareas.cjs",
    "test:auditoria": "node tests/browser-auditoria.cjs",
    "test:modulos": "node tests/browser-modulos.cjs",
    "test:administracion": "node tests/browser-administracion.cjs",
    "test:mensajes": "node tests/browser-mensajes.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
