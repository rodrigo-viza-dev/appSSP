{
  "name": "app-ssp",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 5173",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 5173",
    "web:pruebas": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/web-pruebas.ps1",
    "typecheck": "tsc --noEmit",
    "test:api": "node --test tests/api.test.cjs tests/aulas.test.cjs tests/centro.test.cjs tests/notificaciones.test.cjs",
    "test:navigation": "node tests/browser-navigation.cjs",
    "test:aulas": "node tests/browser-aulas.cjs",
    "test:centro": "node tests/browser-centro.cjs",
    "test:avisos": "node tests/browser-avisos.cjs",
    "test:docencia": "node tests/browser-docencia.cjs",
    "test:asistencia": "node tests/browser-asistencia.cjs",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
